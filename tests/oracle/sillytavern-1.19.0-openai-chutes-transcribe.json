    "version": "1.19.0",
    "commit": "06bde939fb1e9c4c8d8641d810f0a916b5bce127"
  },
  "probe": "tools/probe-openai-chutes-transcribe.mjs",
  "implementedRoutes": [
    "/api/openai/chutes/transcribe-audio"
  ],
  "notImplementedRoutes": [
    "/api/openai/caption-image",
    "/api/openai/generate-video"
  ],
  "notImplementedReasons": {
    "/api/openai/generate-video": "A polling job with three fixed-host request shapes; its own wave.",
    "/api/openai/caption-image": "A chat-completions body over a large per-api branch table; its own wave."
  },
  "pinnedSource": {
    "src/endpoints/openai.js:882": "router.post('/chutes/transcribe-audio'): reads the uploaded file, base64s it, and fetches https://${request.body.model}.chutes.ai/transcribe"
  },
  "mechanism": "The upstream host is derived from the REQUEST, so the probe replaces the `node-fetch` module and the global `fetch` with a controlled peer and asserts BOTH the captured URL (host included) and the captured request COUNT: an escaped request appears as a missing capture rather than as plausible data.",
  "inheritedProperties": {
    "hostInterpolation": "The model is interpolated into the HOSTNAME with no sanitising, so a model containing a dot or a slash redirects the request to another host. Reproduced verbatim and recorded here the way the content-import substring match is recorded; hardening it would be a deliberate compatibility change, not a silent improvement."
  },
  "fields": [
    {
      "path": "scenarios.*.response.status",
      "comparison": "compared",
      "reason": "200, 400 for a refusal, 500 for a provider error or a non-array answer"
    },
    {
      "path": "scenarios.*.response.headers",
      "comparison": "compared",
      "reason": "json for the projection, html for the text bodies"
    },
    {
      "path": "scenarios.*.response.body/bodyText",
      "comparison": "compared",
      "reason": "the joined-chunks projection and the forwarded provider text"
    },
    {
      "path": "scenarios.*.outbound[].url",
      "comparison": "compared",
      "reason": "the HOST is compared exactly, because the model can move it (rule 15)"
    },
    {
      "path": "scenarios.*.outbound[].body",
      "comparison": "compared",
      "reason": "the base64 audio member"
    },
    {
      "path": "scenarios.*.outbound[].headers",
      "comparison": "compared",
      "reason": "the bearer key and content type, asserted in both directions"
    },
    {
      "path": "scenarios.*.outbound.length",
      "comparison": "compared",
      "reason": "exactly one request when the provider is reached and ZERO for a refusal, so an escape cannot hide"
    }
  ],
  "normalizations": [
    "None: the request and the answer are both deterministic."
  ],

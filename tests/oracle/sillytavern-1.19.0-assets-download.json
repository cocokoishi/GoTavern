{
  "schemaVersion": 1,
  "baseline": {
    "version": "1.19.0",
    "commit": "06bde939fb1e9c4c8d8641d810f0a916b5bce127"
  },
  "probe": "pinned /api/assets/download: four guards, the filename-message branch, and the forwarding branches",
  "oracle": {
    "file": "src/endpoints/assets.js",
    "lines": {
      "download": 190
    }
  },
  "conventions": {
    "steps": "steps are an ordered ARRAY: every step snapshots the assets tree the next step starts from",
    "mock": "the peer PORT 18080 is stored as <mock> in inputs and outbound URLs; the replay substitutes its own port, so a scenario can use a different HOST that still reaches the replay peer",
    "refusals": "a refusal records ZERO outbound requests; a forwarding step records exactly one, so a guard that fetched early cannot look correct",
    "filename": "the filename guard answers status(400).send(message), so its body is TEXT and is compared as text; sendStatus branches answer the status phrase as text/plain",
    "mime": "the character branch content type comes from mime.lookup of the temp filename",
    "temp": "the pinned route unlinks assets/temp/<name> after the response is sent, which races the write stream's handle close on Windows: the file survives in some runs and not others (the committed fixture once recorded temp/note.txt; four consecutive re-records of the same input recorded none), so no value under assets/temp is host-independent. Entries under assets/temp are dropped from every recorded tree; the temp DIRECTORY is kept because ensureFoldersExist creates it deterministically."
  },
  "fixtureFields": {
    "compared": [
      "observations.*.status",
      "observations.*.contentType",
      "observations.*.contentLength",
      "observations.*.etag",
      "observations.*.bodyText",
      "observations.*.bodyBase64",
      "observations.*.bodySha256",

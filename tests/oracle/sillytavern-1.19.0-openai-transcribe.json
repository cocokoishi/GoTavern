{
  "schemaVersion": 1,
  "baseline": {
    "version": "1.19.0",
    "commit": "06bde939fb1e9c4c8d8641d810f0a916b5bce127"
  },
  "probe": "tools/probe-openai-transcribe.mjs",
  "implementedRoutes": [
    "/api/openai/transcribe-audio",
    "/api/openai/groq/transcribe-audio",
    "/api/openai/mistral/transcribe-audio",
    "/api/openai/zai/transcribe-audio"
  ],
  "notImplementedRoutes": [
    "/api/openai/caption-image",
    "/api/openai/generate-video",
    "/api/openai/chutes/transcribe-audio"
  ],
  "notImplementedReasons": {
    "/api/openai/chutes/transcribe-audio": "JSON with base64 audio and the model interpolated into the HOSTNAME; its own wave.",
    "/api/openai/caption-image": "A chat-completions body over a large per-api branch table; its own wave.",
    "/api/openai/generate-video": "A polling job with three fixed-host request shapes; its own wave."
  },
  "pinnedSource": {
    "src/endpoints/openai.js:806": "createTranscribeHandler: reads request.file, appends fs.createReadStream to a form-data FormData, then model and optional language",
    "src/endpoints/openai.js:856": "the four registrations, one fixed apiUrl each"
  },
  "mechanism": "Every upstream is a hardcoded literal, so the probe replaces the `node-fetch` module and the global `fetch` with a controlled peer; the Go side uses one handler with four seams and replays the peer through a real listener.",
  "fields": [
    {
      "path": "scenarios.*.response.status",
      "comparison": "compared",
      "reason": "the pinned handler answers 200, 400 for a refusal or 500 for a provider error"
    },
    {
      "path": "scenarios.*.response.headers",
      "comparison": "compared",
      "reason": "json for a pass-through, html for the text bodies"
    },
    {
      "path": "scenarios.*.response.body/bodyText",
      "comparison": "compared",
      "reason": "the provider JSON pass-through and the forwarded provider text"
    },
    {
      "path": "scenarios.*.outbound[].url",
      "comparison": "compared",
      "reason": "four fixed endpoints, one per provider"
    },
    {
      "path": "scenarios.*.outbound[].headers",
      "comparison": "compared",
      "reason": "the bearer key and the multipart content type, asserted in both directions"
    },
    {
      "path": "scenarios.*.outbound[].parts",
      "comparison": "compared",
      "reason": "the multipart parts, because the boundary is random per request; the part list must be NON-EMPTY or the run refuses"
    },
    {
      "path": "scenarios.*.outbound.length",
      "comparison": "compared",
      "reason": "the refusals must reach NO peer, and every success exactly one"
    },
    {
      "path": "uploaded bytes",
      "comparison": "compared",
      "reason": "the forwarded file is compared by digest, and it is synthetic"
    }
  ],
  "normalizations": [
    "The multipart boundary is random per request, so bodies are recorded as parsed parts and the content type records a boundary marker rather than the value."
  ],

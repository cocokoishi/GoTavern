      "inputs": {
        "config": {
          "enableUserAccounts": false,
          "securityOverride": false,
          "perUserBasicAuth": false
        },
        "args": {
          "listen": false,
          "basicAuthMode": false,
          "whitelistMode": false
        },
        "users": []
      },
      "exitCode": null,
      "events": []
    },
    "accountsDisabledExits": {
      "inputs": {
        "config": {
          "enableUserAccounts": false,
          "securityOverride": false,
          "perUserBasicAuth": false
        },
        "args": {
          "listen": true,
          "basicAuthMode": false,
          "whitelistMode": false
        },
        "users": []
      },
      "exitCode": 1,
      "events": [
        {
          "level": "error",
          "args": [
            "Your current SillyTavern configuration is insecure (listening to non-localhost). Enable whitelisting, basic authentication or user accounts."
          ]
        }
      ]
    },

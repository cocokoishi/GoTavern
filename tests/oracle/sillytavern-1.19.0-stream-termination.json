  "probe": "pinned relay response and peer-connection observable for a controlled provider that resets, stalls, redirects, or compresses; compared against GoTavern in the same run",
  "crossHostSupported": true,
  "clientTimeoutMs": 4000,
  "paths": [
    {
      "id": "chat",
      "route": "/api/backends/chat-completions/generate",
      "body": {
        "stream": true,
        "chat_completion_source": "custom",
        "custom_url": "<peer>",
        "custom_model": "probe-model",
        "messages": [
          {
            "role": "user",
            "content": "probe"
          }
        ],
        "max_tokens": 8,
        "temperature": 0,
        "presence_penalty": 0,
        "frequency_penalty": 0,
        "top_p": 1
      },
      "label": "chat-completions stream (forwardFetchResponse)",
      "pinnedLiteral": null
    },
    {
      "id": "kobold",
      "route": "/api/backends/kobold/generate",
      "body": {
        "api_server": "<peer>",
        "prompt": "probe",
        "max_length": 8,
        "streaming": true,
        "temperature": 0,
        "top_p": 1,
        "top_k": 0,
        "rep_pen": 1
      },
      "label": "kobold stream (forwardFetchResponse)",
      "pinnedLiteral": null
    },
    {
      "id": "novelai",
      "route": "/api/novelai/generate",
      "body": {
        "streaming": true,
        "model": "clio-v1",
        "input": "probe",
        "max_length": 8,
        "temperature": 0,
        "top_p": 1,
        "top_k": 0,
        "repetition_penalty": 1
      },
      "label": "novelai stream (forwardFetchResponse)",
      "pinnedLiteral": "https://api.novelai.net"
    },
    {
      "id": "textgen",
      "route": "/api/backends/text-completions/generate",
      "body": {
        "api_server": "<peer>",
        "api_type": "generic",
        "model": "probe-model",
        "prompt": "probe",
        "max_tokens": 8,
        "stream": true,
        "temperature": 0,
        "top_p": 1
      },
      "label": "textgen stream (forwardFetchResponse + searchFetch redirect loop)",
      "pinnedLiteral": null
    },
    {
      "id": "ollama",
      "route": "/api/backends/text-completions/generate",
      "body": {
        "api_server": "<peer>",
        "api_type": "ollama",
        "model": "probe-model",
        "prompt": "probe",
        "stream": true
      },
      "label": "textgen Ollama NDJSON re-framer (parseOllamaStream)",
      "pinnedLiteral": null
    }

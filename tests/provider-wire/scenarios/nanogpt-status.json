{
    "schemaVersion":  1,
    "name":  "nanogpt-status",
    "purpose":  "NANOGPT /status: the arm is a different route from the credits/models routes in sillytavern-1.19.0-nanogpt.json -- it GETs \u003cbase\u003e/models?detailed=true with api_key_nanogpt, and the query is part of the compared target.",
    "stage1Boundary":  "Stage 1 validates the backend -\u003e provider transformation only. Browser-side prompt assembly happens in the frontend before the request reaches the route and is NOT covered here; a green provider-wire capture is not evidence of preset-level equivalence.",
    "targetPath":  "nanogpt",
    "backendConfig":  [
                          "enableUserAccounts: true",
                          "skipContentCheck: true",
                          "requestProxy:",
                          "  enabled: false"
                      ],
    "secrets":  {
                    "api_key_nanogpt":  [
                                            {
                                                "id":  "probe-id-api_key_nanogpt",
                                                "value":  "synthetic-nanogpt-key",
                                                "label":  "api_key_nanogpt",
                                                "active":  true
                                            }
                                        ]
                },
    "expectedAuthorizationKey":  "synthetic-nanogpt-key",
    "transportRedirect":  [
                              {
                                  "from":  "https://nano-gpt.com/api/v1",
                                  "to":  "\u003cmock\u003e"
                              }
                          ],
    "goSeam":  {
                   "environmentVariable":  "GOTAVERN_NANOGPT_CHAT_URL",
                   "value":  "\u003cmock\u003e",
                   "pinnedLiteral":  "https://nano-gpt.com/api/v1"
               },
    "request":  {
                    "path":  "/api/backends/chat-completions/status",
                    "body":  {
                                 "chat_completion_source":  "nanogpt"
                             }
                },
    "mock":  {
                 "responses":  [
                                   {
                                       "status":  200,
                                       "headers":  [
                                                       {
                                                           "name":  "Content-Type",
                                                           "value":  "application/json"
                                                       }
                                                   ],
                                       "body":  "{\"data\":[{\"id\":\"probe-model\",\"context_length\":4096,\"pricing\":{\"prompt\":\"0.000001\",\"completion\":\"0.000002\"}}]}"
                                   }
                               ]
             },
    "normalization":  {
                          "tier2":  [
                                        {
                                            "path":  "provider.requests[].headers.authorization",
                                            "rule":  "compared as the literal \"Bearer \u003csynthetic nanogpt key\u003e\"",
                                            "reason":  "the scenario declines to store the key and records authorizationKeyVerified instead",
                                            "pinnedSource":  "src/endpoints/backends/chat-completions.js:2478 apiKey = readSecret(request.user.directories, SECRET_KEYS.NANOGPT, request.body.secret_id)"
                                        },
                                        {
                                            "path":  "provider.requests[].url",
                                            "rule":  "the recorder origin is replaced with \u003cmock\u003e",
                                            "reason":  "NANOGPT has no reverse_proxy and no custom_url: the branch assigns the hardcoded literal https://nano-gpt.com/api/v1, so the pinned leg reaches the recorder through the probe transport redirect and the Go leg through its seam. The PATH is untouched and IS compared.",
                                            "pinnedSource":  "src/endpoints/backends/chat-completions.js:2477 apiUrl = API_NANOGPT"
                                        }
                                    ],
                          "tier3":  [
                                        {
                                            "path":  "providerResponse.headers[x-response-time]",
                                            "rule":  "excluded",
                                            "reason":  "wall-clock measurement, differs every run",
                                            "pinnedSource":  "src/server-main.js:108 app.use(responseTime())"
                                        }
                                    ]
                      }
}
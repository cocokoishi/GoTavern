{
    "schemaVersion":  1,
    "name":  "groq-nonstream",
    "purpose":  "GROQ source, NON-STREAMING: the control for groq-stream. Pins the branch beyond the shared path: the base literal https://api.groq.com/openai/v1, api_key_groq as a Bearer token, no extra headers, and the json_schema fold into response_format with strict defaulting to true.",
    "stage1Boundary":  "Stage 1 validates the backend -\u003e provider transformation only. Browser-side prompt assembly happens in the frontend before the request reaches the route and is NOT covered here; a green provider-wire capture is not evidence of preset-level equivalence.",
    "targetPath":  "groq",
    "backendConfig":  [
                          "enableUserAccounts: true",
                          "skipContentCheck: true",
                          "requestProxy:",
                          "  enabled: false"
                      ],
    "secrets":  {
                    "api_key_groq":  [
                                         {
                                             "id":  "probe-id-api_key_groq",
                                             "value":  "synthetic-groq-key",
                                             "label":  "api_key_groq",
                                             "active":  true
                                         }
                                     ]
                },
    "expectedAuthorizationKey":  "synthetic-groq-key",
    "transportRedirect":  [
                              {
                                  "from":  "https://api.groq.com/openai/v1",
                                  "to":  "\u003cmock\u003e"
                              }
                          ],
    "goSeam":  {
                   "environmentVariable":  "GOTAVERN_GROQ_CHAT_URL",
                   "value":  "\u003cmock\u003e",
                   "pinnedLiteral":  "https://api.groq.com/openai/v1"
               },
    "request":  {
                    "path":  "/api/backends/chat-completions/generate",
                    "body":  {
                                 "chat_completion_source":  "groq",
                                 "model":  "probe-model",
                                 "messages":  [
                                                  {
                                                      "role":  "system",
                                                      "content":  "probe system marker"
                                                  },
                                                  {
                                                      "role":  "user",
                                                      "content":  "probe user marker"
                                                  }
                                              ],
                                 "max_tokens":  64,
                                 "temperature":  0.5,
                                 "stream":  false,
                                 "json_schema":  {
                                                     "name":  "probe_schema",
                                                     "description":  "probe schema",
                                                     "value":  {
                                                                   "type":  "object",
                                                                   "properties":  {
                                                                                      "answer":  {
                                                                                                     "type":  "string"
                                                                                                 }
                                                                                  }
                                                               }
                                                 }
                             }
                },
    "mock":  {
                 "responses":  [
                                   {
                                       "status":  200,
                                       "headers":  [
                                                       {
                                                           "name":  "Content-Type",
                                                           "value":  "application/json"
                                                       }
                                                   ],
                                       "body":  "{\"id\":\"mock-openrouter\",\"model\":\"probe-model\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"mock reply\"},\"finish_reason\":\"stop\"}]}"
                                   }
                               ]
             },
    "normalization":  {
                          "tier2":  [
                                        {
                                            "path":  "provider.requests[].headers.authorization",
                                            "rule":  "the value is compared as the literal \"Bearer \u003csynthetic groq key\u003e\", never as a recorded secret",
                                            "reason":  "the scenario declares the key it plants, so the value is the contract (a wrong secret NAME would send a different or no token)",
                                            "pinnedSource":  "src/endpoints/backends/chat-completions.js:2457 apiKey = readSecret(request.user.directories, SECRET_KEYS.GROQ, request.body.secret_id)"
                                        },
                                        {
                                            "path":  "provider.requests[].url",
                                            "rule":  "the recorder origin is replaced with \u003cmock\u003e",
                                            "reason":  "GROQ has NO reverse_proxy and NO custom_url: the branch assigns the hardcoded literal https://api.groq.com/openai/v1, so the pinned leg can only reach the recorder through the probe transport redirect and the Go leg through its seam. The PATH is untouched and IS compared, which is the part the pinned literal decides.",
                                            "pinnedSource":  "src/endpoints/backends/chat-completions.js:2456 apiUrl = API_GROQ (\u0027https://api.groq.com/openai/v1\u0027)"
                                        }
                                    ],
                          "tier3":  [
                                        {
                                            "path":  "providerResponse.headers[x-response-time]",
                                            "rule":  "excluded from the compared headers",
                                            "reason":  "It is a measurement of elapsed wall-clock time, so it differs on every run and no backend can match it; the value is a duration, not a contract.",
                                            "pinnedSource":  "src/server-main.js:108 app.use(responseTime())"
                                        }
                                    ]
                      }
}

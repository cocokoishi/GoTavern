                "TestOpenAIRandomizeUserIdSendsAPinnedUUIDv4Member"
            ],
            "note": "a fresh lowercase RFC 4122 v4 UUID as the body's LAST member, OPENAI source only"
        },
        {
            "match": [
                "logging.minLogLevel"
            ],
            "classification": "implemented",
            "implementation": [
                "internal/server/console.go"
            ],
            "tests": [
                "TestConsoleMinLogLevelGatesTheAccessLogConsoleLineOnly",
                "TestConsoleMinLogLevelResolvesLikeSetupLogLevel"

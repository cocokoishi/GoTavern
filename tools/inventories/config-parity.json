            "classification": "implemented",
            "implementation": [
                "internal/server/request_overrides.go"
            ],
            "tests": [
                "TestRequestOverridesReachTheProviderAndWin",
                "TestTokenizerRemoteTextgenEncodeMatchesLoopbackOracle"
            ],
            "note": "first matching entry wins, headers assigned LAST so they override Content-Type/Authorization; the tokenizer route differential records the override on the provider wire"
        },

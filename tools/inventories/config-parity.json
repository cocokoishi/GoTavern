            "classification": "implemented",
            "implementation": [
                "internal/outbound/privatefilter.go",
                "internal/commandline/privateaddress.go"
            ],
            "tests": [
                "TestPrivateAddressFilterSettingsFollowThePinnedReads",
                "TestTheBootedServerEnforcesTheConfiguredPrivateAddressFilter",
                "TestPrivateAddressFilterTreatsAV4MappedV6AddressAsItsV4Address"
            ],
            "note": "the filter blocks on the DNS-resolved address, validates redirect hops and reproduces the pinned ip-matching grammar; one recorded STRICTER divergence for v4-mapped-v6"
        },
        {
            "match": [
                "requestOverrides"
